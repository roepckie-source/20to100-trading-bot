                )
            ),

        "kill_switch":
            bool(
                result.get(
                    "kill_switch",
                    False
                )
            ),
    }


# ============================================================
# SUMMARY
# ============================================================

def build_summary(results):
    """
    Erstellt Asset-/Window-Zusammenfassung.
    """

    if not results:

        return pd.DataFrame()

    df = pd.DataFrame(
        results
    )

    grouped = []

    # --------------------------------------------------------
    # Asset summary
    # --------------------------------------------------------

    for asset, group in df.groupby(
        "asset"
    ):

        grouped.append(
            {
                "asset":
                    asset,

                "capital":
                    "ALL",

                "assets_tested":
                    1,

                "windows":
                    group[
                        "window"
                    ].nunique(),

                "avg_return_pct":
                    group[
                        "return_pct"
                    ].mean(),

                "median_return_pct":
                    group[
                        "return_pct"
                    ].median(),

                "avg_profit_factor":
                    group[
                        "profit_factor"
                    ].replace(
                        [np.inf, -np.inf],
                        np.nan
                    ).mean(),

                "median_profit_factor":
                    group[
                        "profit_factor"
                    ].replace(
                        [np.inf, -np.inf],
                        np.nan
                    ).median(),

                "positive_window_pct":
                    (
                        group[
                            "return_pct"
                        ]
                        > 0
                    ).mean()
                    * 100,

                "pf_gt_1_pct":
                    (
                        group[
                            "profit_factor"
                        ]
                        > 1
                    ).mean()
                    * 100,

                "avg_expectancy":
                    group[
                        "expectancy"
                    ].mean(),

                "total_trades":
                    group[
                        "trades"
                    ].sum(),

                "worst_return_pct":
                    group[
                        "return_pct"
                    ].min(),

                "best_return_pct":
                    group[
                        "return_pct"
                    ].max(),

                "avg_drawdown_pct":
                    group[
                        "max_drawdown_pct"
                    ].mean(),

                "worst_drawdown_pct":
                    group[
                        "max_drawdown_pct"
                    ].min(),

                "assets_positive_pct":
                    100.0
                    if group[
                        "return_pct"
                    ].mean() > 0
                    else 0.0,
            }
        )

    return pd.DataFrame(
        grouped
    )


