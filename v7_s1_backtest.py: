def prepare_data(df):
    """
    Berechnet die exakt benötigten V6-C-Indikatoren.

    V7-S1 verwendet dieselbe Datenbasis wie V6-C.
    """

    data = df.copy()

    data = calculate_indicators(
        data
    )

    return data


# ============================================================
# WALK-FORWARD WINDOWS
# ============================================================

def create_oos_windows(df):
    """
    Erzeugt Rolling OOS-Fenster.

    12 Monate Historie
    +
    3 Monate OOS

    Danach:
    +3 Monate verschieben.
    """

    start = df.index.min()

    end = df.index.max()

    windows = []

    train_delta = pd.DateOffset(
        months=TRAIN_MONTHS
    )

    oos_delta = pd.DateOffset(
        months=OOS_MONTHS
    )

    step_delta = pd.DateOffset(
        months=STEP_MONTHS
    )

    current = start

    window_id = 0

    while True:

        train_start = current

        train_end = (
            train_start
            +
            train_delta
        )

        oos_start = train_end

        oos_end = (
            oos_start
            +
            oos_delta
        )

        if oos_end > end:

            break

        oos = df.loc[
            (df.index >= oos_start)
            &
            (df.index < oos_end)
        ]

        if len(oos) > 0:

            windows.append(
                {
                    "window":
                        window_id,

                    "train_start":
                        train_start,

                    "train_end":
                        train_end,

                    "oos_start":
                        oos_start,

                    "oos_end":
                        oos_end,

                    "oos_rows":
                        len(oos),
                }
            )

        current = (
            current
            +
            step_delta
        )

        window_id += 1

    return windows


# ============================================================
# RUN SINGLE TEST
# ============================================================

def run_single(
    data,
    asset,
    capital,
    window
):
    """
    Führt einen einzelnen V7-S1 OOS-Test aus.
    """

    oos_start = window[
        "oos_start"
    ]

    oos_end = window[
        "oos_end"
    ]

    oos = data.loc[
        (data.index >= oos_start)
        &
        (data.index < oos_end)
    ].copy()

    if len(oos) < 300:

        return None

    # --------------------------------------------------------
    # ENGINE
    # --------------------------------------------------------

    engine = V7SurvivalEngine(

        starting_balance=capital,

        base_risk_per_trade=
            RISK_PER_TRADE,

        fee_rate=
            FEE_RATE,

        slippage_rate=
            SLIPPAGE_RATE,

        atr_stop_multiplier=
            ATR_STOP_MULTIPLIER,

        trailing_atr_multiplier=
            TRAILING_ATR_MULTIPLIER,

        adx_min=
            ADX_MIN,

        max_daily_loss=
            MAX_DAILY_LOSS_PCT / 100.0,

        max_consecutive_losses=
            MAX_CONSECUTIVE_LOSSES,

        loss_cooldown_bars=
            COOLDOWN_BARS,

        global_max_drawdown=
            GLOBAL_MAX_DRAWDOWN_PCT / 100.0,

        variant=
            VARIANT,
    )

    # --------------------------------------------------------
    # RUN
    # --------------------------------------------------------

    result = engine.run(
        oos
    )

    # --------------------------------------------------------
    # RESULT
    # --------------------------------------------------------

    return {

        "asset":
            asset,

        "capital":
            capital,

        "window":
            window["window"],

        "train_start":
            window["train_start"],

        "train_end":
            window["train_end"],

        "oos_start":
            oos_start,

        "oos_end":
            oos_end,

        "oos_rows":
            len(oos),

        "strategy":
            result.get(
                "strategy"
            ),

        "variant":
            result.get(
                "variant"
            ),

        "starting_balance":
            safe_float(
                result.get(
                    "starting_balance"
                )
            ),

        "final_balance":
            safe_float(
                result.get(
                    "final_balance"
                )
            ),

        "profit":
            safe_float(
                result.get(
                    "profit"
                )
            ),

        "return_pct":
            safe_float(
                result.get(
                    "return_pct"
                )
            ),

        "trades":
            int(
                result.get(
                    "trades",
                    0
                )
            ),

        "wins":
            int(
                result.get(
                    "wins",
                    0
                )
            ),

        "losses":
            int(
                result.get(
                    "losses",
                    0
                )
            ),

        "win_rate_pct":
            safe_float(
                result.get(
                    "win_rate"
                )
            ),

        "profit_factor":
            safe_float(
                result.get(
                    "profit_factor"
                )
            ),

        "expectancy":
            safe_float(
                result.get(
                    "expectancy"
                )
            ),

        "max_drawdown_pct":
            safe_float(
                result.get(
                    "max_drawdown_pct"
                )
            ),

        "fees":
            safe_float(
                result.get(
                    "fees"
                )
            ),

        "slippage_cost":
            safe_float(
                result.get(
                    "slippage_cost"
                )
            ),

        "normal_risk_trades":
            int(
                result.get(
                    "normal_risk_trades",
                    0
                )
            ),

        "defensive_risk_trades":
            int(
                result.get(
                    "defensive_risk_trades",
                    0
                )
            ),

        "survival_risk_trades":
            int(
                result.get(
                    "survival_risk_trades",
                    0
                )
            ),

        "critical_risk_trades":
            int(
                result.get(
                    "critical_risk_trades",
